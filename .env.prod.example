# Copy to .env.prod and fill in real values before deploying

POSTGRES_USER=petplace
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=petplace_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://petplace:CHANGE_ME_STRONG_PASSWORD@db:5432/petplace_db
REDIS_URL=redis://redis:6379/0
SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

GOOGLE_GEOCODING_API_KEY=CHANGE_ME

# Leave empty so browser uses relative URLs (through nginx)
NEXT_PUBLIC_API_BASE_URL=

# ─── Clerk ───────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME
CLERK_SECRET_KEY=sk_live_CHANGE_ME
CLERK_JWKS_URL=https://CHANGE_ME.clerk.accounts.dev/.well-known/jwks.json
SUPERADMIN_CLERK_ID=user_CHANGE_ME

# Pre-built images from GitHub Container Registry (pushed by CI)
# Replace YOUR_GITHUB_USERNAME with your actual GitHub username
BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/pet-place-backend:latest
FRONTEND_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/pet-place-frontend:latest
