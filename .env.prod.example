# Copy to .env.prod and fill in real values before deploying

POSTGRES_USER=petplace
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=petplace_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://petplace:CHANGE_ME_STRONG_PASSWORD@db:5432/petplace_db
REDIS_URL=redis://redis:6379/0
SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

GOOGLE_GEOCODING_API_KEY=CHANGE_ME

# Leave empty so browser uses relative URLs (through nginx)
NEXT_PUBLIC_API_BASE_URL=
